# ─────────────────────────────────────────────────────────────────────────────
#  Obryn storefront — environment
#  Copy to `.env.local` and fill in. Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase (Postgres) ────────────────────────────────────────────────────
# Project → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL is safe to expose; the service-role key is NOT and must
# only ever be read on the server (it bypasses row-level security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth ───────────────────────────────────────────────────────────────────
# Sign a random 64+ character string. Used to sign the session JWT.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# ─── Razorpay (payments) ────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Test keys work against Razorpay test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Cloudinary (product image uploads) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Safe to expose — used by the browser for direct uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── AI assistant (RAG) ─────────────────────────────────────────────────────
# Groq powers generation. Free key: https://console.groq.com/keys
#
# GROQ_MODEL is optional. Left unset it uses DEFAULT_MODEL from
# lib/rag/groq.ts (qwen/qwen3.8-27b — fastest on the free tier, ~170 ms for a
# grounded answer). Set it to openai/gpt-oss-120b if you would rather have the
# larger model and can accept ~900 ms.
#
# IMPORTANT: Groq's catalogue differs per account, and the free tier often does
# not expose the Llama models at all. Run `npm run check` to see which models
# your key can actually use — if it lists none, update DEFAULT_MODEL and
# FALLBACK_MODELS in lib/rag/groq.ts to match.
#
# The retriever needs no key: embeddings are computed locally by
# Xenova/bge-small-en-v1.5 and stored in Supabase pgvector.
# Before the assistant can answer from the catalogue, apply supabase/rag.sql and
# run POST /api/knowledge/reindex as an admin.
GROQ_API_KEY=
GROQ_MODEL=